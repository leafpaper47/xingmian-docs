  "c": "io.lumine.mythic.bukkit.commands.spawners.SpawnersCommand",
  "strs": [
   "2\r",
   "  &7Arguments: &6[arg] &f= Required&7, &3<arg> &f= Optional\r",
   "&e/mm s &fcreate &6[name] &6[mob] &3<w,x,y,z> &7? &7&oCreate a mob spawner.\r",
   "&e/mm s &fdelete &6[name] &7? &7&oRemove a mob spawner.\r",
   "&e/mm s &finfo &6[name] &7? &7&oShow info about a spawner.\r",
   "&e/mm s &ffind &3<radius> &7? &7&oList nearby spawners\r",
   "&e/mm s &factivate &6[name] &7? &7&o Force-ticks a spawner.\r",
   "&e/mm s &fset &6[name] &6[attribute] &6[value] &7? &7&oModify spawner attributes.\r",
   "&e/mm s &faddcondition &6[name] &6[condition] &6[value] &7? &7&oAdds a condition to a spawner.\r",
   "&e/mm s &fremovecondition &6[name] &6[condition] &7? &7&oRemoves a condition from a spawner.\r",
   "&6&L ** Page 1 of 2\r",
   "  &7Arguments: &6[arg] &f= Required&7, &3<arg> &f= Optional\r",
   "&e/mm s &fmove &6[name] &7? &7&oMoves the spawner to the location you are looking at.\r",
   "&e/mm s &fcopy &6[name] &6[copyName] &7? &7&oTurns the block you\\'re looking at into a copy of a mob spawner.\r",
   "&e/mm s &fcut &6[name] &7? &7&oCuts the given spawners and saves them to the clipboard.\r",
   "&e/mm s &fpaste &6[name] &7? &7&oPastes spawners in your clipboard based on your relative location.\r",
   "&e/mm s &fundo &7? &7&oUndo the last clipboard-related change you\\'ve done (clipboard must still have spawners in it for this to work)\r",
   "&6&L ** Page 2 of 2\r",
   "mythicmobs.command.spawners\r",
   "spawners\r",
   "s\r",
   "sp\r"
