{
  "name": "Essentials",
  "role": "服务器基础指令总控",
  "summary": "一个插件包下服务器日常指令：传送、家、地标、礼包、经济、背包、禁言封禁、世界时间、查人。管理员的常用指令大部分在这里。",
  "quick": [
    {"scene": "给钱", "cmd": "/eco give Steve 1000", "note": "扣钱用 take，改额用 set；玩家间的 /pay 是另一条"},
    {"scene": "查余额", "cmd": "/bal Steve", "note": "不带名字看自己；榜单用 /baltop"},
    {"scene": "传过去", "cmd": "/tp Steve", "note": "不用对方同意；请求式用 /tpa"},
    {"scene": "清理掉落物", "cmd": "/remove drops 100", "note": "半径必写，不带半径=整个世界"},
    {"scene": "设地标", "cmd": "/setwarp market", "note": "站好位置敲；玩家用 /warp market 过去"},
    {"scene": "重载配置", "cmd": "/ess reload", "note": "改完 config.yml / kits 后用，不重载玩家数据"}
  ],
  "commands": [
    {"cmd": "afk", "what": "把自己标记为暂离", "syntax": "/afk [玩家] [留言]", "examples": ["/afk 吃饭去了"], "notes": "再敲一次取消；别人私聊你会收到自动回复"},
    {"cmd": "antioch", "what": "在你看向的位置炸出一个坑", "syntax": "/antioch [消息]"},
    {"cmd": "anvil", "what": "打开虚拟铁砧（不消耗方块）", "syntax": "/anvil"},
    {"cmd": "back", "what": "回到上次传送或死亡前的位置", "syntax": "/back [玩家]", "examples": ["/back"], "notes": "死亡点要靠 essentials.back.ondeath 才会记录；控制台不能用"},
    {"cmd": "backup", "what": "立刻执行配置里的备份脚本", "syntax": "/backup", "notes": "config.yml 没配 backup.command 时什么都不做"},
    {"cmd": "balance", "what": "查自己或他人的余额", "syntax": "/balance [玩家]", "examples": ["/bal", "/bal Steve"], "notes": "查别人需要 essentials.balance.others"},
    {"cmd": "balancetop", "what": "财富排行榜", "syntax": "/balancetop [页码]", "examples": ["/baltop"], "notes": "榜单有缓存；有 balancetop.force 权限才能强制刷新"},
    {"cmd": "ban", "what": "封禁玩家，踢出并禁止再进", "syntax": "/ban <玩家> [理由]", "examples": ["/ban Griefer 破坏建筑"], "notes": "有 ban.exempt 的人封不掉"},
    {"cmd": "banip", "what": "按 IP 封禁", "syntax": "/banip <IP> [理由]", "notes": "会连带封掉这个 IP 上的所有账号，网吧/家庭网慎用"},
    {"cmd": "beezooka", "what": "发射一只爆炸蜜蜂（整蛊）", "syntax": "/beezooka"},
    {"cmd": "book", "what": "重新打开已封印的书改标题或作者", "syntax": "/book [title|author [名字]]", "notes": "改名/改作者要额外的 book.title、book.author 权限"},
    {"cmd": "bottom", "what": "传送到当前位置最低的方块上", "syntax": "/bottom", "notes": "目标位置是虚空时会直接摔下去"},
    {"cmd": "break", "what": "直接破坏你看着的方块", "syntax": "/break", "notes": "挖基岩要 essentials.break.bedrock"},
    {"cmd": "broadcast", "what": "全服广播一条消息", "syntax": "/broadcast <消息>", "examples": ["/bc 服务器 22:00 重启，请提前保存"], "notes": "别名 /bc；支持 & 颜色码"},
    {"cmd": "broadcastworld", "what": "只广播给某个世界的玩家", "syntax": "/broadcastworld <世界> <消息>", "examples": ["/bcw world_nether 地狱维护中"]},
    {"cmd": "bigtree", "what": "在视线位置生成一棵大树", "syntax": "/bigtree <tree|redwood|jungle|darkoak>"},
    {"cmd": "burn", "what": "让玩家燃烧指定秒数", "syntax": "/burn <玩家> <秒>", "notes": "抗火效果挡不住；秒数上限受配置限制"},
    {"cmd": "cartographytable", "what": "打开虚拟制图台", "syntax": "/cartographytable"},
    {"cmd": "clearinventory", "what": "清空背包", "syntax": "/ci [玩家|*] [物品|*] [数量]", "examples": ["/ci Steve", "/ci Steve diamond"], "notes": "不可撤销；* 表示全服所有人，别手抖"},
    {"cmd": "clearinventoryconfirmtoggle", "what": "开关清背包前的二次确认", "syntax": "/clearinventoryconfirmtoggle", "notes": "关掉后再也看不到确认提示"},
    {"cmd": "condense", "what": "把散装物品压成块（9 铁锭→1 铁块）", "syntax": "/condense [物品名]"},
    {"cmd": "compass", "what": "报出你当前的朝向", "syntax": "/compass"},
    {"cmd": "createkit", "what": "把背包内容存成一个新礼包", "syntax": "/createkit <礼包名> <冷却秒>", "examples": ["/createkit vip 86400"], "notes": "冷却单位是秒；背包里装着什么就存什么，先清干净"},
    {"cmd": "customtext", "what": "执行 bukkit.yml 里定义的自定义文本指令", "syntax": "/<自定义别名>", "notes": "内容和别名都在 bukkit.yml 的 aliases 段，改完要重启"},
    {"cmd": "delhome", "what": "删除一个家", "syntax": "/delhome [玩家:]<家名>", "examples": ["/delhome home", "/delhome Steve:home"]},
    {"cmd": "deljail", "what": "删除一个监狱点", "syntax": "/deljail <监狱名>", "notes": "里面还关着人时会先放出来"},
    {"cmd": "delkit", "what": "删除一个礼包", "syntax": "/delkit <礼包名>"},
    {"cmd": "delwarp", "what": "删除一个地标", "syntax": "/delwarp <地标名>"},
    {"cmd": "depth", "what": "报出当前相对海平面的深度", "syntax": "/depth"},
    {"cmd": "disposal", "what": "打开垃圾桶界面，放进去的东西直接销毁", "syntax": "/disposal", "notes": "关闭界面即销毁，没有回收站"},
    {"cmd": "eco", "what": "直接加减或设置玩家余额", "syntax": "/eco <give|take|set|reset> <玩家> <金额>", "examples": ["/eco give Steve 1000", "/eco take Steve 500"], "notes": "走后台，没有 /pay 的提示与手续费；reset 直接归零"},
    {"cmd": "editsign", "what": "改世界里某块告示牌的文字", "syntax": "/editsign <set|clear|copy|paste> [行号] [文字]", "examples": ["/editsign set 1 &e欢迎"]},
    {"cmd": "enchant", "what": "给手上的物品附魔", "syntax": "/enchant <附魔名> [等级]", "examples": ["/enchant sharpness 5"], "notes": "等级上限看配置，超限会被截断"},
    {"cmd": "enderchest", "what": "打开自己或他人的末影箱", "syntax": "/enderchest [玩家]", "notes": "改别人末影箱要 essentials.enderchest.others"},
    {"cmd": "essentials", "what": "重载 Essentials 配置", "syntax": "/essentials", "examples": ["/ess reload"], "notes": "别名 /ess；只重配置不重载玩家数据"},
    {"cmd": "exp", "what": "查看、给予、设置或重置经验", "syntax": "/exp [show|set|give|reset] [玩家] [数量]", "examples": ["/exp give Steve 30"], "notes": "数量按等级算，不是经验点"},
    {"cmd": "ext", "what": "熄灭玩家身上的火", "syntax": "/ext [玩家]"},
    {"cmd": "feed", "what": "把饥饿值喂满", "syntax": "/feed [玩家]"},
    {"cmd": "fly", "what": "开关飞行", "syntax": "/fly [玩家] [on|off]", "examples": ["/fly", "/fly Steve off"], "notes": "重进服务器后状态可能被重置，取决于配置"},
    {"cmd": "fireball", "what": "发射火球或其他弹射物", "syntax": "/fireball [类型] [速度]", "examples": ["/fireball large 2"], "notes": "类型见回显：small/large/arrow/skull/snowball 等"},
    {"cmd": "firework", "what": "编辑手上烟花的效果与飞行时间", "syntax": "/firework <power|clear|fire|meta>", "notes": "要手里拿着烟花或烟花火箭"},
    {"cmd": "gamemode", "what": "切换游戏模式", "syntax": "/gamemode <survival|creative|adventure|spectator> [玩家]", "examples": ["/gm creative Steve", "/gms"], "notes": "别名 /gm、/gmc、/gms、/gma、/gmsp"},
    {"cmd": "gc", "what": "查看内存、TPS、实体数量", "syntax": "/gc", "notes": "别名 /tps、/mem；卡顿排查第一步"},
    {"cmd": "getpos", "what": "查自己或他人的坐标", "syntax": "/getpos [玩家]", "examples": ["/getpos Steve"], "notes": "别名 /coords、/whereami"},
    {"cmd": "give", "what": "给玩家物品", "syntax": "/give <玩家> <物品> [数量]", "examples": ["/give Steve diamond 64"], "notes": "物品名写错会静默失败"},
    {"cmd": "god", "what": "开关无敌", "syntax": "/god [玩家] [on|off]", "examples": ["/god Steve on"], "notes": "不掉血，但掉出世界/掉虚空仍会死"},
    {"cmd": "grindstone", "what": "打开虚拟砂轮", "syntax": "/grindstone"},
    {"cmd": "hat", "what": "把手上的方块戴到头上", "syntax": "/hat [remove]", "notes": "remove 取下来；原来的头盔会掉回背包"},
    {"cmd": "heal", "what": "回满血量", "syntax": "/heal [玩家]", "notes": "已死的玩家治不了，先复活"},
    {"cmd": "help", "what": "列出你可用的指令", "syntax": "/help [关键词] [页码]", "notes": "关键词能过滤，找子指令用它"},
    {"cmd": "helpop", "what": "给在线管理员发一条求助", "syntax": "/helpop <消息>", "examples": ["/helpop Steve 在主城卡住了"], "notes": "别名 /ac；没管理员在线时没人看见"},
    {"cmd": "home", "what": "传送回自己的家", "syntax": "/home [玩家:][家名]", "examples": ["/home", "/home mine", "/home Steve:home"], "notes": "带冒号是别人的家，要 essentials.home.others"},
    {"cmd": "ice", "what": "熄火并清掉玩家的燃烧状态", "syntax": "/ice [玩家]"},
    {"cmd": "ignore", "what": "屏蔽某个玩家的聊天", "syntax": "/ignore <玩家>", "notes": "再敲一次取消；有 ignoreexempt 的人屏蔽不掉"},
    {"cmd": "info", "what": "看服务器公告的某一章", "syntax": "/info [章节] [页码]", "notes": "内容在 info.txt 里，改完 /ess reload"},
    {"cmd": "invsee", "what": "查看在线玩家的背包", "syntax": "/invsee <玩家>", "notes": "只能看不能改；对方离线会报错"},
    {"cmd": "item", "what": "直接给自己刷物品", "syntax": "/item <物品> [数量]", "examples": ["/item diamond 64"], "notes": "给到手上；要直接进背包用 /give 自己"},
    {"cmd": "itemdb", "what": "查物品的 ID、英文名与耐久", "syntax": "/itemdb <物品>", "notes": "玩家报「这东西叫什么」时用它查"},
    {"cmd": "itemlore", "what": "编辑手上物品的 lore 说明行", "syntax": "/itemlore <add|set|clear> [行号] [文字]", "examples": ["/itemlore add &7活动限定"]},
    {"cmd": "itemname", "what": "给手上的物品改名", "syntax": "/itemname [名字]", "notes": "不带参数是清空名字；支持 & 颜色码"},
    {"cmd": "jailedplayers", "what": "列出所有在押玩家", "syntax": "/jailedplayers"},
    {"cmd": "jails", "what": "列出所有监狱点", "syntax": "/jails"},
    {"cmd": "jump", "what": "传送到视线落点", "syntax": "/jump", "notes": "最远距离受配置限制，太远会失败"},
    {"cmd": "kick", "what": "把玩家踢下线", "syntax": "/kick <玩家> [理由]", "examples": ["/kick Steve 刷屏"]},
    {"cmd": "kickall", "what": "踢掉除自己外的所有在线玩家", "syntax": "/kickall [理由]", "notes": "管理组也会被踢；重启前清人常用"},
    {"cmd": "kill", "what": "杀死指定玩家", "syntax": "/kill <玩家>", "notes": "掉落规则跟正常死亡一致，会掉东西"},
    {"cmd": "kit", "what": "领取礼包，或不带参数列出可用礼包", "syntax": "/kit [礼包] [玩家]", "examples": ["/kit", "/kit vip Steve"], "notes": "有冷却与一次性限制；礼包不存在会提示"},
    {"cmd": "kitreset", "what": "重置礼包冷却", "syntax": "/kitreset <礼包> [玩家]", "examples": ["/kitreset vip Steve"], "notes": "只清冷却，不补发已用过的一次性礼包"},
    {"cmd": "kittycannon", "what": "发射一只爆炸小猫（整蛊）", "syntax": "/kittycannon"},
    {"cmd": "lightning", "what": "在视线处或对玩家劈一道雷", "syntax": "/lightning [玩家] [强度]", "notes": "强度默认 1，1 已经能打死人"},
    {"cmd": "list", "what": "列出在线玩家", "syntax": "/list [组]", "notes": "别名 /who、/online；带组名只列该组"},
    {"cmd": "loom", "what": "打开虚拟织布机", "syntax": "/loom"},
    {"cmd": "mail", "what": "站内信：读、清、发送", "syntax": "/mail <read|clear|send|sendall|sendtemp> [参数]", "examples": ["/mail send Steve 明天活动改到 8 点"], "notes": "sendall 群发要小心；sendtemp 可写过期时间"},
    {"cmd": "me", "what": "以第三人称描述你的动作", "syntax": "/me <动作>", "examples": ["/me 正在修屋顶"]},
    {"cmd": "more", "what": "把手上的物品堆补满", "syntax": "/more [数量]", "notes": "不给数量按最大堆叠补，超出部分掉在地上"},
    {"cmd": "motd", "what": "查看每日消息", "syntax": "/motd [章节] [页码]", "notes": "内容在 motd.txt 里"},
    {"cmd": "msg", "what": "私聊某个玩家", "syntax": "/msg <玩家> <消息>", "examples": ["/msg Steve 来主城一趟"], "notes": "别名 /tell、/w、/pm；对方 /msgtoggle 关了就发不到"},
    {"cmd": "msgtoggle", "what": "开关「拒收所有私聊」", "syntax": "/msgtoggle [玩家] [on|off]"},
    {"cmd": "mute", "what": "禁言或解禁玩家", "syntax": "/mute <玩家> [时长] [理由]", "examples": ["/mute Steve 1h 刷屏"], "notes": "时长写 1d2h30m，不写就是永久；再敲一次解禁"},
    {"cmd": "near", "what": "列出附近的玩家", "syntax": "/near [玩家] [半径]", "examples": ["/near Steve 100"]},
    {"cmd": "nick", "what": "改自己或他人的昵称", "syntax": "/nick [玩家] <昵称|off>", "examples": ["/nick &6大佬", "/nick Steve off"], "notes": "off 恢复真名；过长或含禁用词会被拒"},
    {"cmd": "nuke", "what": "在你上方降下 TNT 雨", "syntax": "/nuke [玩家]", "notes": "会把建筑炸平，正式服别用"},
    {"cmd": "tpoffline", "what": "传送到离线玩家最后登出的位置", "syntax": "/tpoffline <玩家>", "examples": ["/tpoffline Steve"], "notes": "该玩家从没进过服时会失败"},
    {"cmd": "pay", "what": "把自己的钱转给别的玩家", "syntax": "/pay <玩家> <金额>", "examples": ["/pay Steve 500"], "notes": "低于最低金额或余额不够会失败；对方 /paytoggle 关了也转不过去"},
    {"cmd": "paytoggle", "what": "开关「是否接受他人转账」", "syntax": "/paytoggle [玩家] [on|off]"},
    {"cmd": "payconfirmtoggle", "what": "开关转账前的二次确认", "syntax": "/payconfirmtoggle"},
    {"cmd": "ping", "what": "测自己到服务器的延迟", "syntax": "/ping", "notes": "别名 /echo"},
    {"cmd": "playtime", "what": "查自己或他人的游戏时长", "syntax": "/playtime [玩家]"},
    {"cmd": "potion", "what": "给手上的药水加自定义效果", "syntax": "/potion <clear|apply> [效果:强度:时长]", "notes": "要手里拿着药水；不带参数会回显格式说明"},
    {"cmd": "powertool", "what": "把一条指令绑到手上的物品", "syntax": "/powertool [l:|a:|r:|c:|d:]<指令>", "examples": ["/powertool /spawn"], "notes": "左键 l:、右键 r: 等分开绑；{player} 替换成被点的玩家"},
    {"cmd": "powertoollist", "what": "列出所有已绑定的 powertool", "syntax": "/powertoollist"},
    {"cmd": "powertooltoggle", "what": "一次性开关所有 powertool", "syntax": "/powertooltoggle"},
    {"cmd": "ptime", "what": "改玩家的客户端时间", "syntax": "/ptime [list|reset|day|night|17:30] [玩家|*]", "notes": "只改视觉不改世界时间；* 表示全员"},
    {"cmd": "pweather", "what": "改玩家的客户端天气", "syntax": "/pweather [list|reset|storm|sun] [玩家|*]", "notes": "只改视觉，不会停世界下雨"},
    {"cmd": "r", "what": "快速回复最后一个私聊你的人", "syntax": "/r <消息>", "examples": ["/r 马上来"]},
    {"cmd": "rtoggle", "what": "改 /r 的目标：最后发件人还是最后收件人", "syntax": "/rtoggle [玩家] [on|off]"},
    {"cmd": "realname", "what": "由昵称反查真实 ID", "syntax": "/realname <昵称>", "notes": "查小号、核对举报人常用"},
    {"cmd": "recipe", "what": "查物品的合成配方", "syntax": "/recipe <物品> [数量]", "examples": ["/recipe diamond_pickaxe"]},
    {"cmd": "remove", "what": "清理世界里的实体", "syntax": "/remove <all|drops|arrows|boats|minecarts|monsters|animals|[怪物类型]> [半径]", "examples": ["/remove drops 100", "/remove monsters 50"], "notes": "不写半径是整个世界的实体，注意别把玩家要捡的掉落物清了"},
    {"cmd": "renamehome", "what": "给家改名", "syntax": "/renamehome <[玩家:]旧名> <新名>", "examples": ["/renamehome home myhome"]},
    {"cmd": "repair", "what": "修满手上或全部装备的耐久", "syntax": "/repair [hand|all]", "notes": "能否修附魔物品看配置；all 修背包全部"},
    {"cmd": "rest", "what": "重置玩家的疲劳与饱食状态", "syntax": "/rest [玩家]"},
    {"cmd": "rules", "what": "查看服务器规则", "syntax": "/rules [章节] [页码]", "notes": "内容在 rules.txt 里"},
    {"cmd": "seen", "what": "查玩家最后下线时间", "syntax": "/seen <玩家>", "notes": "别名 /alts 还能列出同 IP 的小号"},
    {"cmd": "sell", "what": "把物品卖给服务器换钱", "syntax": "/sell <hand|inventory|blocks|[物品]> [数量]", "examples": ["/sell hand", "/sell inventory"], "notes": "价格由 worth.yml 决定，先用 /worth 看价"},
    {"cmd": "sethome", "what": "把当前位置设成家", "syntax": "/sethome [[玩家:]家名]", "examples": ["/sethome home"], "notes": "家数量上限由 essentials.sethome.multiple 系列权限决定"},
    {"cmd": "setjail", "what": "把当前位置创建成监狱点", "syntax": "/setjail <监狱名>", "examples": ["/setjail jail1"]},
    {"cmd": "settpr", "what": "设随机传送的中心点与范围", "syntax": "/settpr [center|minrange|maxrange] [值]", "notes": "不写参数用当前位置当中心"},
    {"cmd": "setwarp", "what": "把当前位置创建成地标", "syntax": "/setwarp <地标名>", "examples": ["/setwarp market"], "notes": "同名会覆盖；单个地标可单独授权限"},
    {"cmd": "setworth", "what": "设某物品的收购价", "syntax": "/setworth <物品> <价格>", "examples": ["/setworth diamond 100"]},
    {"cmd": "showkit", "what": "预览礼包内容", "syntax": "/showkit <礼包名>", "examples": ["/showkit vip"]},
    {"cmd": "skull", "what": "设置玩家头颅的主人", "syntax": "/skull [主人] [玩家]", "examples": ["/skull Notch"]},
    {"cmd": "smithingtable", "what": "打开虚拟锻造台", "syntax": "/smithingtable"},
    {"cmd": "socialspy", "what": "监听其他人的私聊与站内信", "syntax": "/socialspy [玩家] [on|off]", "notes": "需要 essentials.socialspy；开着时聊天会刷屏"},
    {"cmd": "spawner", "what": "改刷怪笼生成的怪物类型", "syntax": "/spawner <怪物> [延迟]", "notes": "要看着刷怪笼敲；延迟单位 tick"},
    {"cmd": "spawnmob", "what": "生成生物", "syntax": "/spawnmob <怪物>[:数据] [数量] [玩家]", "examples": ["/spawnmob zombie 5"], "notes": "数量受 mobspawnlimit 限制，超了会提示"},
    {"cmd": "speed", "what": "改行走或飞行速度", "syntax": "/speed [walk|fly] <速度> [玩家]", "examples": ["/speed fly 3"], "notes": "正常上限 1，超过要靠 essentials.speed.overspeed"},
    {"cmd": "stonecutter", "what": "打开虚拟切石机", "syntax": "/stonecutter"},
    {"cmd": "sudo", "what": "让另一个玩家以他的身份执行一条指令", "syntax": "/sudo <玩家> <指令>", "examples": ["/sudo Steve /spawn"], "notes": "后果记在对方头上；别用来假装别人转账"},
    {"cmd": "suicide", "what": "自杀", "syntax": "/suicide"},
