{
 "name": "vcm",
 "role": "语音喇叭",
 "summary": "全服语音喇叭：把录好的语音/音效通过资源包广播给全服或指定玩家，常用于活动播报与整蛊彩蛋。",
 "quick": [
  {"scene": "发一个语音喇叭", "cmd": "/vcm give Steve", "note": "把喇叭物品发给玩家，玩家自己用"},
  {"scene": "改完配置生效", "cmd": "/vcm reload", "note": "音效清单改完要重载"},
  {"scene": "打开管理界面", "cmd": "/vcm manager", "note": "查看已加载的音效与播放记录"}
 ],
 "commands": [
  {"cmd": "vcm", "what": "语音喇叭主指令", "syntax": "/vcm <give|reload|manager>",
   "examples": ["/vcm give Steve"], "notes": "命令名 vcm"}
 ],
 "subcommands": [
  {"cmd": "/vcm give <玩家> [数量]", "desc": "发放语音喇叭物品", "example": "/vcm give Steve 3"},
  {"cmd": "/vcm reload", "desc": "重载音效配置与资源索引", "example": "/vcm reload"},
  {"cmd": "/vcm manager", "desc": "打开音效管理界面", "example": "/vcm manager"}
 ],
 "caution": [
  "语音靠资源包下发，玩家没装/没重载资源包会听不到，别当 bug 查。",
  "全服广播类音效别在跑图/战斗高峰刷，容易引发投诉。"
 ],
 "permissions": {
  "vcm.use": "使用语音喇叭物品",
  "vcm.admin": "发放与重载（give / reload / manager）"
 }
}
