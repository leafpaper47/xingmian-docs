{
 "name": "Shopkeepers",
 "role": "NPC 商店",
 "summary": "用村民等实体当店主：玩家右键交易，管理员可创建/编辑/移动/删除店主，支持玩家商店与管理员商店两种模式。",
 "quick": [
  {"scene": "新建一个店主", "cmd": "/shopkeeper create", "note": "对着准星位置的实体创建，先看好类型"},
  {"scene": "编辑店主商品", "cmd": "/shopkeeper edit", "note": "右键店主进入编辑界面加/改商品"},
  {"scene": "把店主挪位置", "cmd": "/shopkeeper move", "note": "先左键选中店主再执行"},
  {"scene": "改完配置生效", "cmd": "/shopkeeper reload", "note": "改 config 后必须重载"}
 ],
 "commands": [
  {"cmd": "shopkeeper", "what": "店主管理主指令", "syntax": "/sk <help|list|reload|create|edit|move|delete|teleport|give|confirm>",
   "examples": ["/sk help"], "notes": "命令名 shopkeeper，别名 /shopkeepers、/sk"}
 ],
 "subcommands": [
  {"cmd": "/sk help", "desc": "打印可用子指令与用法", "example": "/sk help"},
  {"cmd": "/sk list", "desc": "列出全部店主（可按玩家/管理员商店筛选）", "example": "/sk list"},
  {"cmd": "/sk reload", "desc": "重载配置与全部店主数据", "example": "/sk reload"},
  {"cmd": "/sk create", "desc": "在准星目标位置创建店主（默认管理员商店）", "example": "/sk create"},
  {"cmd": "/sk edit", "desc": "编辑店主：商品、价格、名称、交易类型", "example": "/sk edit"},
  {"cmd": "/sk move", "desc": "把选中店主移动到当前位置", "example": "/sk move"},
  {"cmd": "/sk teleport", "desc": "传送到指定店主附近", "example": "/sk teleport"},
  {"cmd": "/sk delete", "desc": "删除店主（需确认）", "example": "/sk delete"},
  {"cmd": "/sk give <玩家>", "desc": "把店主所有权转移给玩家", "example": "/sk give Steve"},
  {"cmd": "/sk confirm", "desc": "确认上一个待确认的危险操作", "example": "/sk confirm"}
 ],
 "caution": [
  "create 用错模式会建成「玩家商店」，普通玩家能随意改商品价格，创建前先确认模式。",
  "delete 需要二次确认，误删店主商品配置不会自动备份，重要商店先 /sk list 记下名字。",
  "店主实体被其他插件清掉（区块清理、实体清理类）后会变成隐形空店主，先 /sk list 核对再重建。"
 ],
 "permissions": {
  "shopkeeper.admin": "创建/删除/移动任意店主",
  "shopkeeper.player": "创建自己的玩家商店",
  "shopkeeper.edit": "编辑店主内容"
 }
}
