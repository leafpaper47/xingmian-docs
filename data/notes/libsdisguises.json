{
 "name": "LibsDisguises",
 "role": "伪装系统",
 "summary": "把玩家或实体伪装成任何生物/物品，带玩家皮肤、自定义名称、动画与选项；活动整活、剧情演出与反作弊排查的主力工具。",
 "quick": [
  {"scene": "把自己变成苦力怕", "cmd": "/disguise creeper", "note": "别名 /d、/dis"},
  {"scene": "取消伪装", "cmd": "/undisguise", "note": "别名 /und、/undis"},
  {"scene": "把某人变成僵尸", "cmd": "/disguiseplayer Steve zombie", "note": "需对目标玩家的伪装权限"},
  {"scene": "整片区域全变", "cmd": "/disguiseradius 10 bat", "note": "半径内全部实体，慎用"}
 ],
 "commands": [
  {"cmd": "disguise", "what": "把自己伪装成指定实体（可带名称、皮肤、选项）", "syntax": "/disguise <类型> [参数...]",
   "examples": ["/disguise creeper", "/disguise player Notch setname &e假玩家"], "notes": "别名 /d、/dis、/disg"},
  {"cmd": "undisguise", "what": "取消自己的伪装", "syntax": "/undisguise", "examples": ["/undisguise"], "notes": "别名 /und、/undis"},
  {"cmd": "disguiseplayer", "what": "把指定玩家伪装成某实体", "syntax": "/disguiseplayer <玩家> <类型> [参数]",
   "examples": ["/disguiseplayer Steve zombie"]},
  {"cmd": "undisguiseplayer", "what": "取消指定玩家的伪装", "syntax": "/undisguiseplayer <玩家>",
   "examples": ["/undisguiseplayer Steve"]},
  {"cmd": "disguiseentity", "what": "把准星指向的实体伪装成另一实体", "syntax": "/disguiseentity <类型> [参数]",
   "examples": ["/disguiseentity cow"], "notes": "要先右键实体选中目标"},
  {"cmd": "undisguiseentity", "what": "取消准星实体的伪装", "syntax": "/undisguiseentity", "examples": ["/undisguiseentity"]},
  {"cmd": "disguiseradius", "what": "半径内所有实体统一伪装", "syntax": "/disguiseradius <半径> <类型>",
   "examples": ["/disguiseradius 10 bat"], "notes": "会把玩家一起改，线上慎用"},
  {"cmd": "undisguiseradius", "what": "取消半径内全部伪装", "syntax": "/undisguiseradius <半径>",
   "examples": ["/undisguiseradius 10"]},
  {"cmd": "disguiseselector", "what": "用实体选择器批量伪装", "syntax": "/disguiseselector <选择器> <类型>",
   "examples": ["/disguiseselector @e[type=zombie] bat"], "notes": "适合精准整片区域，比 radius 安全"},
  {"cmd": "undisguiseselector", "what": "用选择器批量取消伪装", "syntax": "/undisguiseselector <选择器>",
   "examples": ["/undisguiseselector @e[type=zombie]"]},
  {"cmd": "disguiseclone", "what": "复制某个实体的伪装，之后再套用", "syntax": "/disguiseclone <参数>",
   "examples": ["/disguiseclone"], "notes": "调试同一套伪装反复使用时省事"},
  {"cmd": "disguisemodify", "what": "修改自己现有伪装的选项（名称、皮肤等）", "syntax": "/disguisemodify <选项> <值>",
   "examples": ["/disguisemodify setname &c假苦力怕"]},
  {"cmd": "disguisemodifyplayer", "what": "修改指定玩家伪装的选项", "syntax": "/disguisemodifyplayer <玩家> <选项> <值>",
   "examples": ["/disguisemodifyplayer Steve setname &c假僵尸"]},
  {"cmd": "disguiseviewself", "what": "开关「自己能否看见自己的伪装」", "syntax": "/disguiseviewself",
   "examples": ["/disguiseviewself"], "notes": "默认看不见自己，调试时打开"},
  {"cmd": "disguiseviewbar", "what": "开关伪装状态条提示（BOSS 条显示状态）", "syntax": "/disguiseviewbar",
   "examples": ["/disguiseviewbar"]},
  {"cmd": "disguiseanimation", "what": "在自己的伪装上播放动画", "syntax": "/disguiseanimation <动画>",
   "examples": ["/disguiseanimation swing_main_hand"]},
  {"cmd": "disguiseplayeranimation", "what": "在指定玩家的伪装上播放动画", "syntax": "/disguiseplayeranimation <玩家> <动画>",
   "examples": ["/disguiseplayeranimation Steve swing_main_hand"]},
  {"cmd": "copydisguise", "what": "把伪装导出为可复用字符串", "syntax": "/copydisguise [参数]",
   "examples": ["/copydisguise"], "notes": "配合 /savedisguise 存进配置"},
  {"cmd": "savedisguise", "what": "把自定义伪装存进 disguises.yml", "syntax": "/savedisguise <名称> <伪装串>",
   "examples": ["/savedisguise 假苦力怕 creeper setname:&c苦力怕"]},
  {"cmd": "grabskin", "what": "抓取玩家/URL 皮肤并缓存供伪装使用", "syntax": "/grabskin <玩家名|URL>",
   "examples": ["/grabskin Notch"]},
  {"cmd": "grabhead", "what": "获取某皮肤对应的头颅物品", "syntax": "/grabhead <玩家名|URL>", "examples": ["/grabhead Notch"]},
  {"cmd": "disguisehelp", "what": "打印伪装可用类型与参数帮助", "syntax": "/disguisehelp [类型]",
   "examples": ["/disguisehelp"]},
  {"cmd": "libsdisguises", "what": "插件管理指令：重载、配置、调试、统计", "syntax": "/ld <reload|config|count|debug|json|permtest|update|uploadlogs>",
   "examples": ["/ld reload"], "notes": "别名 /libsdisg"}
 ],
 "subcommands": [
  {"cmd": "/ld reload", "desc": "重载配置与 disguise 定义", "example": "/ld reload"},
  {"cmd": "/ld config", "desc": "查看/修改运行期配置项", "example": "/ld config"},
  {"cmd": "/ld count", "desc": "统计当前伪装数量与类型分布", "example": "/ld count"},
  {"cmd": "/ld permtest <玩家>", "desc": "检查某玩家对指定伪装的权限", "example": "/ld permtest Steve"},
  {"cmd": "/ld debug", "desc": "开启调试输出（排查伪装不显示）", "example": "/ld debug"},
  {"cmd": "/ld json", "desc": "导出伪装 JSON 供排查", "example": "/ld json"},
  {"cmd": "/ld update", "desc": "检查插件更新", "example": "/ld update"},
  {"cmd": "/ld uploadlogs", "desc": "上传日志生成排查链接", "example": "/ld uploadlogs"}
 ],
 "caution": [
  "disguiseradius 会把范围内的玩家也一起改，线上整活前先确认没别人在旁边。",
  "伪装需要客户端接受实体元数据，配合 ProtocolLib/新版服务端时出问题优先 /ld reload 再看 debug。",
  "玩家伪装成生物后碰撞箱与受击判定仍按原玩家，别用伪装做「隐藏玩家」的安全手段。"
 ],
 "permissions": {
  "libsdisguises.disguise": "使用 /disguise",
  "libsdisguises.disguise.player": "把自己伪装成玩家（带皮肤）",
  "libsdisguises.disguise.<类型>": "允许伪装成某个具体生物类型",
  "libsdisguises.disguiseplayer": "使用 /disguiseplayer",
  "libsdisguises.disguiseradius": "使用 /disguiseradius",
  "libsdisguises.admin": "管理指令（reload / config / debug）"
 }
}
