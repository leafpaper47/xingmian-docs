{
  "name": "Residence",
  "role": "领地保护",
  "summary": "用选区工具圈地创建受保护住宅，配子区域、权限标志、成员管理与出租出售；管理员用 /resadmin 直接干预他人领地。",
  "quick": [
    {"scene": "圈一块地", "cmd": "/res select 10", "note": "进入选区模式后点两个对角方块，再 /res create 名字"},
    {"scene": "给访客开权限", "cmd": "/res pset home use true", "note": "常用标志 build/use/container/pvp/move/tp"},
    {"scene": "加同住玩家", "cmd": "/res set home Trusted Steve", "note": "等级 Order<Member<Trusted"},
    {"scene": "查看自己有哪些地", "cmd": "/res list", "note": "加玩家名查他人；/res listall 需管理权限"},
    {"scene": "管理员清违规领地", "cmd": "/resadmin removeall Steve", "note": "删该玩家全部住宅，先留证据"}
  ],
  "commands": [
    {"cmd": "res select", "what": "进入/退出选区模式（也可直接用选区工具点方块）", "syntax": "/res select <半径>",
     "params": [{"name": "半径", "required": true, "note": "以你为中心的水平半径，10 即 20×20"}],
     "examples": ["/res select 10"], "notes": "选区过大超出区块上限会失败"},
    {"cmd": "res create", "what": "把当前选区建成住宅", "syntax": "/res create <住宅名>",
     "params": [{"name": "住宅名", "required": true, "note": "自己名下唯一，不能含空格"}],
     "examples": ["/res create home"], "notes": "按区块数量扣钱；与他人领地重叠直接拒绝", "permission": "residence.create"},
    {"cmd": "res remove", "what": "删除自己的住宅", "syntax": "/res remove <住宅名>",
     "params": [{"name": "住宅名", "required": true, "note": "可用 /res list 查"}],
     "examples": ["/res remove home"], "notes": "不可撤销，需 /res confirm 二次确认", "permission": "residence.delete"},
    {"cmd": "res area", "what": "在住宅内划子区域（房间、农场分区）", "syntax": "/res area <add|remove|replace> <子区域名> [父住宅]",
     "params": [{"name": "add", "required": true, "note": "add 新建、remove 删除、replace 重定义范围"}],
     "examples": ["/res area add farm home"], "notes": "子区域继承父住宅标志，可单独 pset 覆盖"},
    {"cmd": "res subzone", "what": "把子区域升级成可单独授权/出租的小领地", "syntax": "/res subzone <子区域名> [父住宅]",
     "examples": ["/res subzone room1 home"], "notes": "升级后能加成员、能挂市场出售"},
    {"cmd": "res pset", "what": "给某个玩家或子区域单独设权限标志", "syntax": "/res pset <住宅> <玩家|子区域> <标志> <true|false|remove>",
     "params": [{"name": "标志", "required": true, "note": "build/use/container/pvp/move/tp/damage/animals 等"}],
     "examples": ["/res pset home Steve build true", "/res pset home container false"],
     "notes": "remove 表示删掉这条覆盖设置；分组标志（redstone 等）一次设一组"},
    {"cmd": "res gset", "what": "设置整块住宅的全局标志", "syntax": "/res gset <住宅> <标志> <值>",
     "examples": ["/res gset home pvp false"], "notes": "影响所有非成员；单人/子区域的 pset 优先级更高"},
    {"cmd": "res set", "what": "添加或移除住宅成员", "syntax": "/res set <住宅> <Order|Member|Trusted|None> <玩家>",
     "params": [{"name": "等级", "required": true, "note": "Member 能用容器，Trusted 能建造并授权，None 移除"}],
     "examples": ["/res set home Member Steve", "/res set home None Steve"]},
    {"cmd": "res lset", "what": "按玩家等级批量改标志", "syntax": "/res lset <住宅> <等级> <标志> <值>",
     "examples": ["/res lset home Member use true"]},
    {"cmd": "res flags", "what": "列出某住宅全部标志的当前状态", "syntax": "/res flags <住宅> [页码]",
     "examples": ["/res flags home"], "notes": "排查「为什么他能开箱」先跑这个"},
    {"cmd": "res info", "what": "看住宅详情：所有者、大小、成员、租金", "syntax": "/res info <住宅>",
     "examples": ["/res info home"], "notes": "不带参数看自己脚下的领地"},
    {"cmd": "res list", "what": "列出某玩家名下的住宅", "syntax": "/res list [玩家] [页码]",
     "examples": ["/res list", "/res list Steve"]},
    {"cmd": "res listall", "what": "列出全服所有住宅", "syntax": "/res listall [页码]",
     "examples": ["/res listall 1"], "permission": "residence.command.listall"},
    {"cmd": "res tp", "what": "传送到住宅", "syntax": "/res tp <住宅>",
     "examples": ["/res tp home"], "notes": "需要该住宅 tp 标志为 true 或是成员"},
    {"cmd": "res tpset", "what": "把你当前位置设为住宅传送点", "syntax": "/res tpset [住宅]",
     "examples": ["/res tpset home"]},
    {"cmd": "res kick", "what": "把某玩家踢出住宅", "syntax": "/res kick <住宅> <玩家>",
     "examples": ["/res kick home Griefer"], "notes": "对方仍在领地内会被持续弹开"},
    {"cmd": "res limits", "what": "查看自己还能建多少块、多大面积", "syntax": "/res limits [玩家]",
     "examples": ["/res limits"], "notes": "上限由权限组发放（residence.maxarea 等），玩家报错常见来源"},
    {"cmd": "res bank", "what": "住宅租金账户的查询/存入/取出", "syntax": "/res bank <deposit|withdraw|balance> [金额] [住宅]",
     "examples": ["/res bank deposit 500 home"], "notes": "租金从余额扣，不足会走租约到期流程"},
    {"cmd": "res market", "what": "挂市场出售/出租住宅，或撤回/成交查询", "syntax": "/res market <sell|rent|unsell|unrent|buy|info> [价格] [住宅]",
     "examples": ["/res market sell 5000 home"], "notes": "rent 的价格单位是天"},
    {"cmd": "res lease", "what": "续租或放弃租约", "syntax": "/res lease <renew|release> <住宅>",
     "examples": ["/res lease renew home"]},
    {"cmd": "res contract", "what": "给住宅写出租/出售合同", "syntax": "/res contract <住宅> [天数] [价格]",
     "examples": ["/res contract shop 30 2000"], "permission": "residence.command.contract"},
    {"cmd": "res message", "what": "设置进出领地时的提示语", "syntax": "/res message <住宅> <enter|leave|remove> <文本>",
     "examples": ["/res message home enter &e欢迎回家"]},
    {"cmd": "res rename", "what": "重命名住宅", "syntax": "/res rename <旧名> <新名>",
     "examples": ["/res rename home myhome"]},
    {"cmd": "res tool", "what": "更换选区工具物品", "syntax": "/res tool [物品]",
     "examples": ["/res tool blaze_rod"], "notes": "改完要手持该物品点击才生效"},
    {"cmd": "res unstuck", "what": "卡在领地边界时把自己弹出去", "syntax": "/res unstuck",
     "examples": ["/res unstuck"]},
    {"cmd": "res version", "what": "查看版本与更新提示", "syntax": "/res version",
     "examples": ["/res version"]},
    {"cmd": "resadmin setowner", "what": "把住宅所有权转给其他玩家", "syntax": "/resadmin setowner <住宅> <玩家>",
     "examples": ["/resadmin setowner home Steve"], "permission": "residence.admin",
     "notes": "原所有者立即失去权限，常用于玩家退服资产回收"},
    {"cmd": "resadmin removeall", "what": "删除某玩家名下全部住宅", "syntax": "/resadmin removeall <玩家>",
     "examples": ["/resadmin removeall Griefer"], "permission": "residence.admin",
     "notes": "不可撤销，先 /res list 核对名单"},
    {"cmd": "resadmin give", "what": "把住宅转给指定玩家", "syntax": "/resadmin give <住宅> <玩家>",
     "examples": ["/resadmin give home Steve"], "permission": "residence.admin"},
    {"cmd": "resadmin server", "what": "把住宅设为服务器所有（不绑定玩家）", "syntax": "/resadmin server <住宅>",
     "examples": ["/resadmin server spawn_market"], "permission": "residence.admin"},
    {"cmd": "resreload", "what": "重载配置与语言文件", "syntax": "/resreload",
     "examples": ["/resreload"], "notes": "改完 config.yml 必须跑；不重载玩家数据", "permission": "residence.command.reload"},
    {"cmd": "resload", "what": "重新读取住宅存档文件", "syntax": "/resload",
     "examples": ["/resload"], "notes": "用磁盘内容覆盖内存，误用会丢最近改动", "permission": "residence.command.reload"}
  ],
  "subcommands": [
    {"cmd": "/res ?", "desc": "分页帮助，是最全的子指令清单", "example": "/res ? 2"},
    {"cmd": "/res signupdate", "desc": "刷新领地牌子上的文字", "example": "/res signupdate home"},
    {"cmd": "/rc", "desc": "住宅频道聊天（含 setprefix/setcolor/kick）", "example": "/rc setprefix &e[家里]"}
  ],
  "caution": [
    "/res remove、/resadmin removeall、/resadmin setowner 不可撤销，先 /res list 核对。",
    "/resload 用磁盘内容覆盖内存，手工改存档后使用，误用丢数据。",
    "玩家「建不了地」多半是 /res limits 到顶或选区超区块上限，先查这两条。"
  ],
  "permissions": {
    "residence.admin": "完全管理权（含全部 /resadmin 子指令）",
    "residence.command.reload": "允许执行 /resreload 与 /resload",
    "residence.command.listall": "允许列出全服住宅",
    "residence.command.contract": "允许给住宅写出租/出售合同"
  }
}
