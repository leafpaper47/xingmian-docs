{
 "name": "PlayerSignIn",
 "role": "玩家签到",
 "summary": "每日签到累积奖励，支持补签卡、跨服/离线玩家补发签到卡，以及签到数据格式升级。",
 "quick": [
  {"scene": "玩家签到", "cmd": "/psi", "note": "默认子指令即签到，等价 /psi signIn"},
  {"scene": "看自己的签到卡", "cmd": "/psi card", "note": "查连签天数与累计次数"},
  {"scene": "给玩家发补签卡", "cmd": "/psi giveSignCard Steve 1", "note": "数量按需，别一次给太多"},
  {"scene": "改完配置生效", "cmd": "/psi reload", "note": "签到奖励改完必须重载"}
 ],
 "commands": [
  {"cmd": "playerSignIn", "what": "签到系统主指令", "syntax": "/playerSignIn <signIn|card|giveSignCard|convert|reload>",
   "examples": ["/psi", "/psi card", "/psi giveSignCard Steve 1"], "notes": "别名 psi，写 /psi 即可"}
 ],
 "subcommands": [
  {"cmd": "/psi signIn", "desc": "执行每日签到（/psi 不带参数也是签到）", "example": "/psi signIn"},
  {"cmd": "/psi card", "desc": "查看自己的签到卡（连签天数、累计次数）", "example": "/psi card"},
  {"cmd": "/psi giveSignCard <玩家> <数量>", "desc": "给玩家发放补签卡", "example": "/psi giveSignCard Steve 1"},
  {"cmd": "/psi convert", "desc": "转换/升级历史签到数据（升级后用一次）", "example": "/psi convert"},
  {"cmd": "/psi reload", "desc": "重载签到配置与奖励表", "example": "/psi reload"}
 ],
 "caution": [
  "补签卡是可消耗道具，giveSignCard 直接进背包，发错要手动回收。",
  "convert 会改写签到数据文件，执行前备份 plugins/PlayerSignIn/。",
  "奖励表改了要 reload，否则玩家签到仍按旧配置发放。"
 ],
 "permissions": {
  "playerSignIn.default": "普通玩家签到与查看签到卡",
  "playerSignIn.signIn": "执行签到",
  "playerSignIn.card": "查看签到卡",
  "playerSignIn.giveSignCard": "发放补签卡",
  "playerSignIn.convert": "转换历史签到数据",
  "playerSignIn.reload": "重载配置",
  "playerSignIn.*": "以上全部"
 }
}
