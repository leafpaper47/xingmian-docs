{
 "name": "OpenInv",
 "role": "远程开箱",
 "summary": "管理员远程打开玩家背包与末影箱并搜索物品，还能按材料、附魔、半径查容器，查盗号查赃物必备。",
 "quick": [
  {"scene": "看某人背包", "cmd": "/openinv Steve", "note": "不填玩家= 看自己"},
  {"scene": "查谁身上有钻石", "cmd": "/searchinv diamond 64", "note": "第二个参数是最少数量"},
  {"scene": "查附近箱子", "cmd": "/searchcontainer diamond_block 5", "note": "半径按区块算，默认 5"},
  {"scene": "查谁有抢夺附魔", "cmd": "/searchenchant looting 3", "note": "附魔名用原版 id"}
 ],
 "commands": [
  {"cmd": "openinv", "what": "打开玩家背包（可编辑）", "syntax": "/openinv [玩家]",
   "examples": ["/openinv Steve"], "notes": "改动会直接落到对方背包，操作前先截图留证"},
  {"cmd": "clearinv", "what": "清空玩家背包", "syntax": "/clearinv [玩家]",
   "examples": ["/clearinv Steve"], "notes": "不可撤销，先用 /openinv 确认内容"},
  {"cmd": "openender", "what": "打开玩家末影箱", "syntax": "/openender [玩家]", "examples": ["/openender Steve"]},
  {"cmd": "clearender", "what": "清空玩家末影箱", "syntax": "/clearender [玩家]", "examples": ["/clearender Steve"]},
  {"cmd": "searchinv", "what": "搜索哪些在线玩家背包里有某材料", "syntax": "/searchinv <材料> [最少数量]",
   "params": [{"name": "材料", "required": true, "note": "原版 id，如 diamond、netherite_ingot"}],
   "examples": ["/searchinv diamond 64"]},
  {"cmd": "searchender", "what": "搜索哪些玩家末影箱里有某材料", "syntax": "/searchender <材料> [最少数量]",
   "examples": ["/searchender shulker_box"]},
  {"cmd": "searchenchant", "what": "按附魔与等级搜索在线玩家", "syntax": "/searchenchant <附魔> [等级]",
   "examples": ["/searchenchant mending"], "notes": "附魔名不带命名空间，等级不填则任意等级"},
  {"cmd": "searchcontainer", "what": "搜索周围区块内装着某材料的容器", "syntax": "/searchcontainer <材料> [区块半径]",
   "params": [{"name": "区块半径", "required": false, "note": "默认 5，过大容易卡服"}],
   "examples": ["/searchcontainer diamond_block 5"], "notes": "只扫已加载区块"},
  {"cmd": "silentcontainer", "what": "静默容器：开关箱子无音效无开盖动画", "syntax": "/silentcontainer [check|on|off]",
   "examples": ["/silentcontainer on"], "notes": "查号时用，避免在线玩家听到箱子声"},
  {"cmd": "anycontainer", "what": "允许打开被方块挡住的容器", "syntax": "/anycontainer [check|on|off]",
   "examples": ["/anycontainer on"], "notes": "配 /silentcontainer on 一起用最隐蔽"}
 ],
 "caution": [
  "/clearinv 与 /clearender 不可撤销，先 /openinv 或 /searchinv 取证。",
  "远程开箱是真改数据，动过的物品会真的落到玩家身上，别当只读查看用。",
  "搜索只覆盖在线玩家与已加载区块，离线玩家查不到。"
 ],
 "permissions": {
  "openinv.inventory.open.other": "打开他人背包",
  "openinv.enderchest.open.other": "打开他人末影箱",
  "openinv.clear.other": "清空他人背包/末影箱",
  "openinv.search.inventory": "使用 /searchinv /searchender /searchenchant",
  "openinv.search.container": "使用 /searchcontainer",
  "openinv.container.silent": "使用静默容器",
  "openinv.container.any": "使用 /anycontainer"
 }
}
