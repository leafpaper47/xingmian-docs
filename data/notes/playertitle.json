{
 "name": "PlayerTitle",
 "role": "称号系统",
 "summary": "玩家称号的发放、佩戴、商城与粒子特效，称号可带属性增益与展示粒子，是常用的氪金/活动奖励载体。",
 "quick": [
  {"scene": "玩家看自己的称号", "cmd": "/plt open", "note": "主界面里佩戴/卸下"},
  {"scene": "打开称号商城", "cmd": "/plt shop", "note": "用点券或称号币购买"},
  {"scene": "给玩家发称号", "cmd": "/plt title give Steve <称号id>", "note": "补偿/活动发放"},
  {"scene": "改完配置生效", "cmd": "/plt reload", "note": "称号表在配置文件里"}
 ],
 "commands": [
  {"cmd": "playertitle", "what": "称号主指令（玩家端 open/shop，其余为管理）", "syntax": "/plt <open|shop|title|card|buff|coin|particle|reward|clear|player|view|reload|convert>",
   "examples": ["/plt open"], "notes": "别名 /plt"}
 ],
 "subcommands": [
  {"cmd": "/plt open", "desc": "打开称号界面（玩家端）", "example": "/plt open"},
  {"cmd": "/plt shop", "desc": "打称号商城（玩家端）", "example": "/plt shop"},
  {"cmd": "/plt title <give|remove|list> <玩家> [称号]", "desc": "发放/回收/查询玩家称号", "example": "/plt title give Steve vip_2025"},
  {"cmd": "/plt card <玩家> <数量>", "desc": "发放称号卡（抽称号的道具）", "example": "/plt card Steve 5"},
  {"cmd": "/plt buff <玩家> <buff> <时长>", "desc": "给玩家的称号附加临时增益", "example": "/plt buff Steve speed 600"},
  {"cmd": "/plt particle <玩家> <粒子>", "desc": "设置称号展示粒子效果", "example": "/plt particle Steve flame"},
  {"cmd": "/plt coin <玩家> <数量>", "desc": "调整玩家称号币余额", "example": "/plt coin Steve 100"},
  {"cmd": "/plt reward <玩家>", "desc": "手动触发称号奖励结算", "example": "/plt reward Steve"},
  {"cmd": "/plt clear <玩家>", "desc": "清空玩家已获得的称号", "example": "/plt clear Steve"},
  {"cmd": "/plt player <玩家>", "desc": "查看玩家称号数据面板", "example": "/plt player Steve"},
  {"cmd": "/plt view <玩家>", "desc": "以只读方式查看玩家当前佩戴的称号", "example": "/plt view Steve"},
  {"cmd": "/plt getip <玩家>", "desc": "按称号来源查询相关玩家 IP 归属（风控用）", "example": "/plt getip Steve"},
  {"cmd": "/plt reload", "desc": "重载称号配置与商城", "example": "/plt reload"},
  {"cmd": "/plt convert", "desc": "转换数据源（换存档格式前先备份）", "example": "/plt convert"}
 ],
 "caution": [
  "clear 会清掉玩家所有已获得称号，且通常不带二次确认，操作前先 /plt player 确认。",
  "称号带属性增益时，改称号属性会让在线玩家立即生效，注意别把平衡性调崩。",
  "convert 属于数据迁移，跑之前备份 plugins/PlayerTitle/。"
 ],
 "permissions": {
  "playertitle.use": "使用称号界面（默认开启）",
  "playertitle.shop": "使用称号商城",
  "playertitle.admin": "称号管理（发放/回收/重载）"
 }
}
