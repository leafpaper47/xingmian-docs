{
 "name": "EliteMobs",
 "role": "精英怪物",
 "summary": "按配置生成带技能与血条的精英怪/自定义 BOSS，配套地牢、战利品与等级缩放，是 PVE 内容的主要来源。",
 "quick": [
  {"scene": "看当前精英怪状态", "cmd": "/elitemobs status", "note": "开关状态、活跃数量与版本"},
  {"scene": "临时关掉精英怪", "cmd": "/elitemobs off", "note": "维护/活动时用，不影响已生成的"},
  {"scene": "手动刷一只", "cmd": "/elitemobs spawn <怪物id>", "note": "怪物 id 来自 mobs 配置"},
  {"scene": "改完配置生效", "cmd": "/elitemobs reload", "note": "重载不会重建已存在的怪"}
 ],
 "commands": [
  {"cmd": "elitemobs", "what": "精英怪主指令：开关、状态、刷怪与重载", "syntax": "/elitemobs <on|off|toggle|status|reload|spawn>",
   "examples": ["/elitemobs status"], "notes": "别名 /elite、/em"}
 ],
 "subcommands": [
  {"cmd": "/elitemobs status", "desc": "查看精英怪系统状态（开关、数量、版本）", "example": "/elitemobs status"},
  {"cmd": "/elitemobs on", "desc": "开启精英怪生成", "example": "/elitemobs on"},
  {"cmd": "/elitemobs off", "desc": "关闭精英怪生成（已存在的不受影响）", "example": "/elitemobs off"},
  {"cmd": "/elitemobs toggle", "desc": "在开/关之间切换", "example": "/elitemobs toggle"},
  {"cmd": "/elitemobs spawn <怪物id> [等级]", "desc": "在当前位置刷出指定精英怪", "example": "/elitemobs spawn zombie_boss 50"},
  {"cmd": "/elitemobs reload", "desc": "重载配置、怪物与战利品表", "example": "/elitemobs reload"}
 ],
 "caution": [
  "off 只停「新生成」，场上已有的精英怪会继续活动，活动结束要连同已生成的怪一起清。",
  "reload 不会替换已存在的怪，改了怪物属性要让它重新生成才生效。",
  "怪物 id 写错时不会报错，只是什么都不刷——排错先 /elitemobs status 看配置是否加载成功。"
 ],
 "permissions": {
  "elitemobs.admin": "使用 /elitemobs 全部子指令"
 }
}
