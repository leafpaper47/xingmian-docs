{
 "name": "PlaceholderAPI",
 "role": "变量占位符",
 "summary": "全服变量中转站：把等级/经济/在线人数等数据变成 %xxx% 占位符，供计分板、聊天、菜单等插件引用，并可从云端下载扩展包。",
 "quick": [
  {"scene": "看装了哪些扩展", "cmd": "/papi list", "note": "显示已加载的扩展与作者"},
  {"scene": "测变量能不能出值", "cmd": "/papi parse me %player_level%", "note": "最常用的排错手段"},
  {"scene": "下载扩展包", "cmd": "/papi ecloud download Player", "note": "下载后必须 /papi reload"},
  {"scene": "改完配置生效", "cmd": "/papi reload", "note": "重载所有扩展与配置"}
 ],
 "commands": [
  {"cmd": "papi", "what": "占位符主指令：扩展管理、解析测试、云端操作", "syntax": "/papi <help|list|info|parse|reload|version|ecloud ...>",
   "examples": ["/papi list"], "notes": "别名 /placeholderapi"}
 ],
 "subcommands": [
  {"cmd": "/papi list", "desc": "列出已安装的扩展（含版本与作者）", "example": "/papi list"},
  {"cmd": "/papi info <扩展>", "desc": "查看某扩展的详细信息与占用情况", "example": "/papi info Player"},
  {"cmd": "/papi parse <玩家> <文本>", "desc": "用指定玩家上下文解析占位符，直接看到替换结果", "example": "/papi parse Steve %player_level%"},
  {"cmd": "/papi parse me <文本>", "desc": "以自己为上下文解析（玩家最常用）", "example": "/papi parse me %server_online%"},
  {"cmd": "/papi reload", "desc": "重载配置并重新注册全部扩展", "example": "/papi reload"},
  {"cmd": "/papi version", "desc": "查看 PAPI 版本与更新状态", "example": "/papi version"},
  {"cmd": "/papi dump", "desc": "导出诊断信息（反馈问题用）", "example": "/papi dump"},
  {"cmd": "/papi ecloud download <扩展>", "desc": "从云端下载扩展 jar", "example": "/papi ecloud download Player"},
  {"cmd": "/papi ecloud update <扩展|all>", "desc": "更新云端扩展", "example": "/papi ecloud update all"},
  {"cmd": "/papi ecloud refresh", "desc": "刷新云端扩展列表缓存", "example": "/papi ecloud refresh"},
  {"cmd": "/papi ecloud status", "desc": "查看云端可用性与本地缓存状态", "example": "/papi ecloud status"},
  {"cmd": "/papi ecloud list <all|installed|作者>", "desc": "列出云端扩展", "example": "/papi ecloud list installed"},
  {"cmd": "/papi ecloud placeholders <扩展>", "desc": "查看某扩展提供的全部占位符", "example": "/papi ecloud placeholders Player"},
  {"cmd": "/papi ecloud clear", "desc": "清空本地云端缓存", "example": "/papi ecloud clear"},
  {"cmd": "/papi register <jar 名>", "desc": "手动注册一个本地扩展 jar", "example": "/papi register MyExpansion.jar"},
  {"cmd": "/papi unregister <扩展>", "desc": "卸载某个扩展", "example": "/papi unregister Player"}
 ],
 "caution": [
  "占位符解析失败时先 `/papi parse me %xxx%` 单测，再怀疑引用方插件——90% 的「计分板不显示」是变量名写错或扩展没加载。",
  "ecloud download 之后必须 /papi reload 才生效，很多人以为下载完就完事了。",
  "PAPI 本身不产出数据，`%xxx%` 全靠扩展；没装对应扩展的占位符会原样显示。"
 ],
 "permissions": {
  "placeholderapi.admin": "使用 /papi 管理类子指令"
 }
}
