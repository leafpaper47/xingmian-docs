{
 "name": "LobbyGames",
 "role": "小游戏汇总",
 "summary": "大厅里的成套小游戏（2048/扫雷/贪吃蛇/井字棋/数独/桌球/四子棋/足球/雪球战），玩家一条命令进游戏，服务器侧无需额外状态。",
 "quick": [
  {"scene": "看有哪些小游戏", "cmd": "/lg join", "note": "不带游戏名会列出可玩清单"},
  {"scene": "直接进 2048", "cmd": "/lgjoin 2048", "note": "别名也可直接当命令：/2048"},
  {"scene": "把人踢出游戏", "cmd": "/lg kick Steve", "note": "需 lobbygames.kickplayer"},
  {"scene": "清排行榜", "cmd": "/lg clearleaderboard", "note": "不可撤销，活动结算后再清"}
 ],
 "commands": [
  {"cmd": "lobbygames", "what": "小游戏主指令：进入、管理、排行、传送", "syntax": "/lg <join|list|tp|kick|create|delete|leaderboard|reload|help>",
   "examples": ["/lg help"], "notes": "别名 /lg、/minigames"},
  {"cmd": "lgjoin", "what": "直接进入指定小游戏", "syntax": "/lgjoin <游戏>",
   "examples": ["/lgjoin snake"], "notes": "每个游戏还有独立别名（/snake、/ttt、/connect4…）"},
  {"cmd": "lgjoinplayer", "what": "把指定玩家送进某局游戏（控制台可用）", "syntax": "/lgjoinplayer <玩家> <游戏>",
   "examples": ["/lgjoinplayer Steve minesweeper"], "notes": "别名 /lgforcejoin；需 lobbygames.forcejoin"}
 ],
 "subcommands": [
  {"cmd": "/lg join", "desc": "查看可玩小游戏并进入", "example": "/lg join"},
  {"cmd": "/lg list", "desc": "列出进行中的游戏与所在服务器", "example": "/lg list"},
  {"cmd": "/lg tp <玩家>", "desc": "传送到某玩家正在玩的对局", "example": "/lg tp Steve"},
  {"cmd": "/lg kick <玩家>", "desc": "把玩家踢出对局", "example": "/lg kick Steve"},
  {"cmd": "/lg leaderboard", "desc": "查看排行榜（别名 /lg lb）", "example": "/lg lb"},
  {"cmd": "/lg clearleaderboard", "desc": "清空排行榜", "example": "/lg clearleaderboard"},
  {"cmd": "/lg create <游戏>", "desc": "创建一局游戏", "example": "/lg create tictactoe"},
  {"cmd": "/lg delete <游戏>", "desc": "删除一局游戏", "example": "/lg delete tictactoe"},
  {"cmd": "/lg reload", "desc": "重载配置与别名开关", "example": "/lg reload"}
 ],
 "caution": [
  "小游戏对局在内存里，重启服务器会全部丢失，活动前别重启。",
  "clearleaderboard 没有二次确认，赛季结算前先导出排行榜。",
  "关掉 lg-join-command-enabled 后 /lgjoin 失效，玩家只能靠告示牌或控制台送达。"
 ],
 "permissions": {
  "lobbygames.command": "使用 /lg list 与 /lg tp",
  "lobbygames.kickplayer": "使用 /lg kick",
  "lobbygames.forcejoin": "使用 /lgjoinplayer",
  "lobbygames.admin": "使用 /lg leaderboard、/lg create、/lg delete"
 }
}
