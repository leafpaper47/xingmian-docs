{
 "name": "GSit",
 "role": "坐姿动作",
 "summary": "让玩家坐、躺、趴、转圈、爬行的动作插件，右键台阶就能坐下，不用敲命令也能玩。",
 "quick": [
  {"scene": "坐下", "cmd": "/sit", "note": "右键台阶/楼梯也能坐，按 Shift 起身"},
  {"scene": "躺下", "cmd": "/lay", "note": "床以外的地方也能躺"},
  {"scene": "关掉右键自动坐", "cmd": "/sit toggle", "note": "个人开关，不影响别人"},
  {"scene": "改完配置重载", "cmd": "/gsitreload", "note": "别名 /gsitrl"}
 ],
 "commands": [
  {"cmd": "gsit", "what": "坐下；带参数可坐下他人或切换开关", "syntax": "/gsit [toggle|playertoggle|玩家]",
   "examples": ["/sit", "/sit Steve"], "notes": "toggle 关自己右键自动坐；playertoggle 关掉别人坐你身上的能力"},
  {"cmd": "glay", "what": "躺下（仰卧）", "syntax": "/glay", "examples": ["/lay"], "permission": "GSit.Lay"},
  {"cmd": "glayback", "what": "趴着躺（俯卧）", "syntax": "/glayback", "examples": ["/layback"], "permission": "GSit.LayBack"},
  {"cmd": "gbellyflop", "what": "肚皮朝下摔趴", "syntax": "/gbellyflop", "examples": ["/bellyflop"], "permission": "GSit.Bellyflop"},
  {"cmd": "gspin", "what": "原地转圈", "syntax": "/gspin", "examples": ["/spin"], "notes": "转圈期间视角被带动，别在跑图时用", "permission": "GSit.Spin"},
  {"cmd": "gcrawl", "what": "进入/退出爬行姿态", "syntax": "/gcrawl [toggle]", "examples": ["/crawl"],
   "notes": "爬行时身高降到 0.6 格，可钻 1 格洞", "permission": "GSit.Crawl"},
  {"cmd": "gsitreload", "what": "重载 GSit 配置", "syntax": "/gsitreload", "examples": ["/gsitreload"],
   "notes": "别名 /gsitrl；改完 config 必须执行", "permission": "GSit.Reload"}
 ],
 "subcommands": [
  {"cmd": "/sit toggle", "desc": "关闭/开启自己右键自动就坐", "example": "/sit toggle"},
  {"cmd": "/sit playertoggle", "desc": "允许/禁止其他玩家坐到你身上", "example": "/sit playertoggle"},
  {"cmd": "/sit <玩家>", "desc": "把指定玩家按到座位上", "example": "/sit Steve"}
 ],
 "caution": [
  "玩家「右键坐不下去」先查 GSit.Sit 与 GSit.SitClick 权限，再看自己是不是关了 toggle。",
  "爬行与躺下会改碰撞箱，狭窄矿道里容易卡住。"
 ],
 "permissions": {
  "GSit.Sit": "使用 /sit 坐下（默认开启）",
  "GSit.SitClick": "右键台阶自动坐下",
  "GSit.SitToggle": "允许 /sit toggle 关闭自动就坐",
  "GSit.PlayerSit": "允许坐其他玩家",
  "GSit.Kick.Sit": "允许把坐着的人踢起来"
 }
}
