{
 "name": "BetterRTP",
 "role": "随机传送",
 "summary": "随机传送玩家到安全落点，支持按世界/生物群系指定、组队队列、冷却与经济扣费，是生存服最常用的传送工具。",
 "quick": [
  {"scene": "玩家随机传送", "cmd": "/rtp", "note": "默认在当前世界随机找安全点"},
  {"scene": "传到指定世界", "cmd": "/rtp world resource", "note": "世界名用 Multiverse 里的名字"},
  {"scene": "传送到某生物群系", "cmd": "/rtp biome desert", "note": "找不到符合条件的点会失败重试"},
  {"scene": "帮别人传送", "cmd": "/rtp player Steve", "note": "管理员代传，不影响自己位置"}
 ],
 "commands": [
  {"cmd": "rtp", "what": "随机传送；不带参数= 给自己传，带参数= 指定世界/玩家/群系", "syntax": "/rtp [世界] [玩家] [群系]",
   "examples": ["/rtp", "/rtp resource"], "notes": "别名 /wild、/randomtp"}
 ],
 "subcommands": [
  {"cmd": "/rtp world <世界>", "desc": "在指定世界随机传送", "example": "/rtp world resource"},
  {"cmd": "/rtp biome <群系>", "desc": "传送到指定生物群系", "example": "/rtp biome desert"},
  {"cmd": "/rtp player <玩家>", "desc": "把指定玩家随机传送", "example": "/rtp player Steve"},
  {"cmd": "/rtp location <世界> <x> <z>", "desc": "传送到指定的坐标点（不走随机）", "example": "/rtp location world 100 200"},
  {"cmd": "/rtp queue", "desc": "查看/管理排队中的传送请求", "example": "/rtp queue"},
  {"cmd": "/rtp settings", "desc": "查看当前生效的传送参数（范围/冷却/重试）", "example": "/rtp settings"},
  {"cmd": "/rtp info", "desc": "查看玩家或世界的传送限制", "example": "/rtp info"},
  {"cmd": "/rtp reload", "desc": "重载配置", "example": "/rtp reload"},
  {"cmd": "/rtp test", "desc": "跑一次落点测试（不实际传送）", "example": "/rtp test"},
  {"cmd": "/rtp version", "desc": "查看版本与更新状态", "example": "/rtp version"},
  {"cmd": "/rtp logger", "desc": "开启/关闭传送日志记录", "example": "/rtp logger"},
  {"cmd": "/rtp edit", "desc": "交互式修改配置项", "example": "/rtp edit"}
 ],
 "caution": [
  "落点安全判定有重试上限，重试打满会直接失败；把「最大尝试次数」调太低会导致频繁传送失败。",
  "跨世界传送要求世界名与服务器实际世界键一致（Multiverse 自定义维度名容易写错）。",
  "冷却与经济扣费分「成功才扣」和「发起就扣」两种配置，改错会让玩家白扣钱。"
 ],
 "permissions": {
  "betterrtp.use": "使用 /rtp 随机传送",
  "betterrtp.world.<世界>": "允许传送到指定世界",
  "betterrtp.biome": "允许按生物群系传送",
  "betterrtp.other": "给其他玩家传送（player / playersudo）",
  "betterrtp.bypass.cooldown": "跳过传送冷却",
  "betterrtp.admin": "管理指令（reload / edit / settings）"
 }
}
