{
 "name": "ModelEngine",
 "role": "自定义模型",
 "summary": "把 Blockbench 做的 3D 模型挂到生物或玩家身上，提供召唤、伪装、状态机与 LOD 控制，是自定义 BOSS 外观的底层支撑。",
 "quick": [
  {"scene": "召唤一个模型", "cmd": "/meg summon <模型id>", "note": "模型 id 来自 blueprints 目录"},
  {"scene": "把玩家伪装成模型", "cmd": "/meg disguise <模型id>", "note": "剧情演出/娱乐用"},
  {"scene": "加了新模型", "cmd": "/meg reload", "note": "重载后玩家需重连才收到资源包"},
  {"scene": "模型显示异常", "cmd": "/meg resync", "note": "强制客户端重新同步"}
 ],
 "commands": [
  {"cmd": "meg", "what": "模型引擎主指令", "syntax": "/meg <reload|summon|disguise|undisguise|menu|debug|resync|test|health|togglelod>",
   "examples": ["/meg reload", "/meg help"], "notes": "注册指令即 /meg"}
 ],
 "subcommands": [
  {"cmd": "/meg reload", "desc": "重载全部模型与配置", "example": "/meg reload"},
  {"cmd": "/meg summon <模型> [位置]", "desc": "在世界里召唤一个模型实体", "example": "/meg summon star_dragon"},
  {"cmd": "/meg disguise <模型> [玩家]", "desc": "把玩家或实体伪装成模型", "example": "/meg disguise star_dragon Steve"},
  {"cmd": "/meg undisguise [玩家]", "desc": "取消伪装", "example": "/meg undisguise Steve"},
  {"cmd": "/meg menu", "desc": "打开模型选择菜单", "example": "/meg menu"},
  {"cmd": "/meg debug", "desc": "输出调试信息（状态、渲染层、LOD）", "example": "/meg debug"},
  {"cmd": "/meg resync", "desc": "强制客户端重新同步模型资源包", "example": "/meg resync"},
  {"cmd": "/meg test", "desc": "跑内置自检（动画/状态机）", "example": "/meg test"},
  {"cmd": "/meg health", "desc": "查看模型引擎运行健康度", "example": "/meg health"},
  {"cmd": "/meg togglelod", "desc": "开关 LOD 分级渲染", "example": "/meg togglelod"}
 ],
 "caution": [
  "新模型必须 reload，且玩家要重连客户端才会收到新资源包，别以为是没生效。",
  "模型绑在实体上，区块卸载或 /kill 可能留残影，出问题先 resync。",
  "debug 与 test 会刷大量日志，线上别长开。"
 ],
 "permissions": {
  "modelengine.command": "使用 ModelEngine 指令",
  "modelengine.admin": "管理权限（reload / debug / summon）"
 }
}
