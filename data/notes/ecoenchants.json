{
 "name": "EcoEnchants",
 "role": "自定义附魔",
 "summary": "给物品加原版没有的附魔（挖掘/战斗/工具类），附魔按权限与稀有度分发，可做附魔书、附魔台规则与描述开关。",
 "quick": [
  {"scene": "看有哪些自定义附魔", "cmd": "/ee gui", "note": "图形化浏览附魔清单"},
  {"scene": "给自己打附魔", "cmd": "/ee enchant <附魔> 3", "note": "第三个参数可指定玩家"},
  {"scene": "发附魔书", "cmd": "/ee givebook random", "note": "活动奖励常用"},
  {"scene": "改完配置生效", "cmd": "/ee reload", "note": "附魔表改完必须重载"}
 ],
 "commands": [
  {"cmd": "ecoenchants", "what": "自定义附魔主指令", "syntax": "/ee <gui|enchant|givebook|reload|toggle>",
   "examples": ["/ee gui"], "notes": "命令名 ecoenchants，常用别名 /ee"}
 ],
 "subcommands": [
  {"cmd": "/ee gui", "desc": "打开展示所有附魔的图形界面", "example": "/ee gui"},
  {"cmd": "/ee enchant <附魔> [等级] [玩家]", "desc": "给手持物品打上指定附魔", "example": "/ee enchant telepathy 3"},
  {"cmd": "/ee enchant <附魔> <等级> <玩家>", "desc": "给指定玩家的手持物品打附魔", "example": "/ee enchant telepathy 3 Steve"},
  {"cmd": "/ee givebook random", "desc": "随机发放一本附魔书", "example": "/ee givebook random"},
  {"cmd": "/ee givebook <附魔> [等级]", "desc": "发放指定附魔的附魔书", "example": "/ee givebook telepathy 2"},
  {"cmd": "/ee toggle", "desc": "开关附魔描述显示（物品 lore 里的说明）", "example": "/ee toggle"},
  {"cmd": "/ee reload", "desc": "重载全部附魔配置", "example": "/ee reload"}
 ],
 "caution": [
  "附魔生效与「玩家有没有该附魔的权限」绑定，玩家拿到书也用不了多半是权限没给。",
  "改了附魔属性/等级上限后，已存在的物品不会自动更新，需要重新打附魔。",
  "toggle 只影响描述显示，不影响附魔实际效果，别拿它当开关用。"
 ],
 "permissions": {
  "ecoenchants.gui": "打开附魔界面",
  "ecoenchants.enchant": "使用 /ee enchant 打附魔",
  "ecoenchants.givebook": "发放附魔书",
  "ecoenchants.reload": "重载配置",
  "ecoenchants.enchant.<附魔>": "允许玩家使用/获得某个具体附魔"
 }
}
