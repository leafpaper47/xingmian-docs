{
  "name": "Essentials",
  "role": "服务器基础指令总控，管理、传送、经济全靠它",
  "summary": "Essentials 是 Minecraft 服务端最常见的基础指令插件，把传送、家与地标、经济、封禁禁言、物品与背包管理、运行状态查询这些日常操作打包成一套指令。它自己就能管钱（用 eco 给钱），也可以通过 Vault 把余额共享给商店、点券、任务类插件。管理员绝大部分后台操作都从它开始，配合 LuckPerms 管权限、EssentialsSpawn 管多世界出生点最顺手。",
  "whatFor": [
    "新玩家进服要用地标、家、新手礼包这类基础福利指令",
    "日常管人：封禁、限时封禁、禁言、踢人、查坐标、看背包",
    "搭主城：设地标、设出生点附近的家、配随机传送的中心和半径",
    "配经济：给钱扣钱、给物品定回收价、做财富排行榜",
    "自己排查问题：看 TPS、内存、在线名单、某人最后一次上线时间"
  ],
  "flow": [
    "先在控制台执行 /essentials 确认插件加载正常、版本正确",
    "用 LuckPerms 把 essentials.* 或按需的 essentials.xxx 发给管理组，普通玩家只给传送、家、私信这类",
    "用 /setwarp 把主城、副本、商店等重要地点标出来，玩家用 /warp 名单里的地标传送",
    "用 /eco、/setworth、/createkit 配好启动资金、回收价和新手礼包",
    "最后按需调 config.yml 里的冷却、传送等待秒数、以及是否开启 tpa 需要对方同意"
  ],
  "commands": [
    {"cmd": "afk", "what": "把自己或指定玩家标记为暂离，可附自定义留言", "syntax": "/afk [玩家名或留言]", "examples": ["/afk 去吃饭了"]},
    {"cmd": "antioch", "what": "OP 恶搞指令，在原地炸出一发大范围 TNT", "syntax": "/antioch [留言]", "examples": ["/antioch"]},
    {"cmd": "anvil", "what": "原地打开铁砧界面，修装备、改名字不用回家", "syntax": "/anvil", "examples": ["/anvil"]},
    {"cmd": "back", "what": "回到上一次传送或死亡之前的位置", "syntax": "/back [玩家名]", "examples": ["/back"]},
    {"cmd": "backup", "what": "按配置立刻触发一次服务器备份", "syntax": "/backup", "examples": ["/backup"]},
    {"cmd": "balance", "what": "查看自己或他人的金币余额", "syntax": "/balance [玩家名]", "examples": ["/balance Steve"]},
    {"cmd": "balancetop", "what": "查看服务器财富排行榜", "syntax": "/balancetop [页码]", "examples": ["/balancetop 1"]},
    {"cmd": "ban", "what": "封禁玩家，可以附上原因", "syntax": "/ban 玩家名 [原因]", "examples": ["/ban Steve 使用作弊客户端"]},
    {"cmd": "banip", "what": "封禁某个 IP 地址", "syntax": "/banip IP地址 [原因]", "examples": ["/banip 203.0.113.7 恶意刷屏"]},
    {"cmd": "beezooka", "what": "娱乐指令，向准心方向射出一只爆炸蜜蜂", "syntax": "/beezooka", "examples": ["/beezooka"]},
    {"cmd": "bigtree", "what": "在准心处生成一棵大树，可指定树种", "syntax": "/bigtree 树种", "examples": ["/bigtree redwood"]},
    {"cmd": "book", "what": "重新打开手里的成书继续编辑", "syntax": "/book [title 或 author 参数：新名字]", "examples": ["/book"]},
    {"cmd": "bottom", "what": "传送到当前位置最低的一层可站立方块", "syntax": "/bottom", "examples": ["/bottom"]},
    {"cmd": "break", "what": "直接破坏准心对着的那个方块", "syntax": "/break", "examples": ["/break"]},
    {"cmd": "broadcast", "what": "向全服玩家发一条公告", "syntax": "/broadcast 消息内容", "examples": ["/broadcast 服务器十分钟后重启，请先下线保存"]},
    {"cmd": "broadcastworld", "what": "只向指定世界发公告", "syntax": "/broadcastworld 世界名 消息内容", "examples": ["/broadcastworld world 主城今晚八点活动"]},
    {"cmd": "burn", "what": "点燃指定玩家若干秒", "syntax": "/burn 玩家名 秒数", "examples": ["/burn Steve 5"]},
    {"cmd": "cartographytable", "what": "原地打开制图台", "syntax": "/cartographytable", "examples": ["/cartographytable"]},
    {"cmd": "clearinventory", "what": "清空自己或他人背包，可按物品筛选", "syntax": "/clearinventory [玩家名或星号] [物品或星号] [数量]", "examples": ["/clearinventory Steve"]},
    {"cmd": "clearinventoryconfirmtoggle", "what": "开关清背包前的二次确认提示", "syntax": "/clearinventoryconfirmtoggle", "examples": ["/clearinventoryconfirmtoggle"]},
    {"cmd": "compass", "what": "报告自己当前的朝向和方位", "syntax": "/compass", "examples": ["/compass"]},
    {"cmd": "condense", "what": "把背包里的散装物品压成块，如铁锭转铁块", "syntax": "/condense [物品名]", "examples": ["/condense iron_ingot"]},
    {"cmd": "createkit", "what": "把自己当前背包内容存成一个礼包", "syntax": "/createkit 礼包名 冷却秒数", "examples": ["/createkit newbie 86400"]},
    {"cmd": "customtext", "what": "配合 bukkit.yml 的自定义指令，输出一段纯文本", "syntax": "/自定义文本指令名", "examples": ["/自定义文本指令名"]},
    {"cmd": "delhome", "what": "删除自己的某个家", "syntax": "/delhome [玩家名:]家名", "examples": ["/delhome home2"]},
    {"cmd": "deljail", "what": "删除指定监狱点", "syntax": "/deljail 监狱名", "examples": ["/deljail jail1"]},
    {"cmd": "delkit", "what": "删除指定礼包", "syntax": "/delkit 礼包名", "examples": ["/delkit newbie"]},
    {"cmd": "delwarp", "what": "删除指定地标", "syntax": "/delwarp 地标名", "examples": ["/delwarp shop"]},
    {"cmd": "depth", "what": "报告当前高度相对海平面的深度", "syntax": "/depth", "examples": ["/depth"]},
    {"cmd": "disposal", "what": "打开随身垃圾桶，随手丢东西", "syntax": "/disposal", "examples": ["/disposal"]},
    {"cmd": "eco", "what": "管理经济：给钱、扣钱、设置、清零", "syntax": "/eco 增减方式 玩家名 金额", "examples": ["/eco give Steve 1000"]},
    {"cmd": "editsign", "what": "直接改写地上告示牌的文字", "syntax": "/editsign set或clear或copy或paste [行号] [文字]", "examples": ["/editsign set 1 欢迎来到星冕服务器"]},
    {"cmd": "enchant", "what": "给手上的物品附魔并指定等级", "syntax": "/enchant 附魔名 [等级]", "examples": ["/enchant sharpness 5"]},
    {"cmd": "enderchest", "what": "打开自己或他人的末影箱", "syntax": "/enderchest [玩家名]", "examples": ["/enderchest Steve"]},
    {"cmd": "essentials", "what": "查看 Essentials 的版本与加载状态", "syntax": "/essentials", "examples": ["/essentials"]},
    {"cmd": "exp", "what": "给经验、设经验、清零或查看经验", "syntax": "/exp 操作 玩家名 [数值]", "examples": ["/exp give Steve 30"]},
    {"cmd": "ext", "what": "熄灭自己或他人身上的火", "syntax": "/ext [玩家名]", "examples": ["/ext Steve"]},
