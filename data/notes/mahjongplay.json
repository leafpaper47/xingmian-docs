{
 "name": "MahjongPlay",
 "role": "麻将小游戏",
 "summary": "服内四人麻将：开桌、入座就绪、机器人补位、出牌与结算，带权限细分到每个子指令。",
 "quick": [
  {"scene": "开一桌", "cmd": "/mj create", "note": "创建牌桌并拿到桌号"},
  {"scene": "加入牌桌", "cmd": "/mj join <桌号>", "note": "提示桌号无效时先 /mj list"},
  {"scene": "人不够，补机器人", "cmd": "/mj bot", "note": "机器人补位后再 start"},
  {"scene": "开始牌局", "cmd": "/mj start", "note": "全员 ready 才能开始"},
  {"scene": "打出一张牌", "cmd": "/mj action <操作>", "note": "摸/打/吃/碰/杠/胡 都在 action 下"}
 ],
 "commands": [
  {"cmd": "mahjong", "what": "麻将主指令（开桌/入座/出牌/结算）", "syntax": "/mahjong <create|join|leave|ready|unready|start|bot|kick|destroy|info|list|action>",
   "examples": ["/mj create", "/mj join 1", "/mj start"], "notes": "别名 mj、majiang；权限按子指令细分"}
 ],
 "subcommands": [
  {"cmd": "/mj create", "desc": "创建牌桌（返回桌号）", "example": "/mj create"},
  {"cmd": "/mj join <桌号>", "desc": "加入指定牌桌", "example": "/mj join 1"},
  {"cmd": "/mj leave", "desc": "离开当前牌桌", "example": "/mj leave"},
  {"cmd": "/mj ready", "desc": "标记自己已准备", "example": "/mj ready"},
  {"cmd": "/mj unready", "desc": "取消准备状态", "example": "/mj unready"},
  {"cmd": "/mj start", "desc": "开始牌局（需全员准备）", "example": "/mj start"},
  {"cmd": "/mj bot", "desc": "用机器人补位", "example": "/mj bot"},
  {"cmd": "/mj kick <玩家>", "desc": "把玩家移出牌桌（桌主/管理）", "example": "/mj kick Steve"},
  {"cmd": "/mj destroy", "desc": "解散当前牌桌", "example": "/mj destroy"},
  {"cmd": "/mj info [桌号]", "desc": "查看牌桌状态", "example": "/mj info 1"},
  {"cmd": "/mj list", "desc": "列出所有牌桌", "example": "/mj list"},
  {"cmd": "/mj action <摸|打|吃|碰|杠|胡>", "desc": "牌局内执行操作", "example": "/mj action 打 3万"}
 ],
 "caution": [
  "玩家中途下线会占座，人不在时用 /mj kick 或 /mj destroy 清桌，否则桌号会一直被占用。",
  "牌面依赖客户端资源包，没装包的玩家看到的是方块占位图标，不是数据错误。"
 ],
 "permissions": {
  "mahjongplay.command.create": "创建牌桌",
  "mahjongplay.command.join": "加入牌桌",
  "mahjongplay.command.leave": "离开牌桌",
  "mahjongplay.command.ready": "准备 / 取消准备",
  "mahjongplay.command.start": "开始牌局",
  "mahjongplay.command.bot": "机器人补位",
  "mahjongplay.command.kick": "踢人出桌",
  "mahjongplay.command.destroy": "解散牌桌",
  "mahjongplay.command.info": "查看牌桌状态",
  "mahjongplay.command.list": "列出牌桌",
  "mahjongplay.command.action": "牌局内操作（摸打吃碰杠胡）"
 }
}
