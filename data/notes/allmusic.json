{
 "name": "allmusic",
 "role": "点歌/音乐",
 "summary": "全服音乐播放：玩家点歌投票、按歌单播放、支持 HUD 歌词显示与禁歌名单；管理员通过 /music 管理歌单、封禁与重载。",
 "quick": [
  {"scene": "玩家点歌", "cmd": "/music select 千本桜", "note": "按关键词搜索后确认选择"},
  {"scene": "看当前歌曲列表", "cmd": "/music list", "note": "列出已加载曲库"},
  {"scene": "跳过当前歌", "cmd": "/music next", "note": "需要投票或管理员权限"},
  {"scene": "禁掉某首歌", "cmd": "/music ban <歌曲id>", "note": "被禁的歌不再进入随机池"}
 ],
 "commands": [
  {"cmd": "music", "what": "音乐系统主指令（点歌/投票/歌单/管理）", "syntax": "/music <list|search|select|next|vote|hud|join|push|cancel|stop|ban|unban|addlist|clearlist|delete|reload|test>",
   "examples": ["/music search 千本桜", "/music list"], "notes": "命令名 music；普通玩家可用点歌类子指令，管理类需权限"}
 ],
 "subcommands": [
  {"cmd": "/music list", "desc": "列出曲库中的歌曲（分页）", "example": "/music list"},
  {"cmd": "/music search <关键词>", "desc": "按歌名/作者搜索曲库", "example": "/music search 千本桜"},
  {"cmd": "/music select <编号|歌名>", "desc": "选定要播放的歌曲", "example": "/music select 12"},
  {"cmd": "/music next", "desc": "切换到下一首（投票或权限）", "example": "/music next"},
  {"cmd": "/music vote", "desc": "为跳歌/切歌投票", "example": "/music vote"},
  {"cmd": "/music hud [on|off]", "desc": "开关歌词 HUD 显示", "example": "/music hud on"},
  {"cmd": "/music join", "desc": "加入当前音乐房间/跟随播放", "example": "/music join"},
  {"cmd": "/music cancel", "desc": "取消自己的点歌/投票", "example": "/music cancel"},
  {"cmd": "/music stop", "desc": "停止当前播放（管理）", "example": "/music stop"},
  {"cmd": "/music push <玩家> <歌曲>", "desc": "直接给指定玩家推一首歌（管理）", "example": "/music push Steve 千本桜"},
  {"cmd": "/music ban [玩家|歌曲]", "desc": "禁歌或禁某玩家点歌", "example": "/music ban 12"},
  {"cmd": "/music unban [玩家|歌曲]", "desc": "解除禁歌/禁点", "example": "/music unban 12"},
  {"cmd": "/music addlist <歌曲>", "desc": "把歌曲加入指定歌单/收藏列表", "example": "/music addlist 千本桜"},
  {"cmd": "/music clearlist", "desc": "清空当前歌单", "example": "/music clearlist"},
  {"cmd": "/music delete <歌曲>", "desc": "从曲库删除歌曲", "example": "/music delete 12"},
  {"cmd": "/music reload", "desc": "重载曲库与配置（新加的歌才出现）", "example": "/music reload"},
  {"cmd": "/music test <歌曲>", "desc": "试听/测试播放（排查卡顿时用）", "example": "/music test 12"}
 ],
 "caution": [
  "歌名或编号写错不会报错，只会静默不播放，先 /music list 拿到准确编号。",
  "HUD 歌词与计分板/TAB 可能重叠，玩家反馈「字叠在一起」时先关 hud 排查。",
  "新放入的音乐文件必须 /music reload 才会出现在曲库，reload 期间正在播放的歌会中断。"
 ],
 "permissions": {
  "music.use": "使用点歌、列表、搜索等基础子指令",
  "music.admin": "管理类子指令（ban/unban/delete/reload/push/stop）"
 }
}
