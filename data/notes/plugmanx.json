{
 "name": "PlugManX",
 "role": "插件热管理",
 "summary": "不重启服务器就能卸载、装载、重载单个插件，并检查插件依赖与命令占用，装新插件、救崩溃插件的首选工具。",
 "quick": [
  {"scene": "重载某个插件", "cmd": "/plugman reload Essentials", "note": "多数插件重载后配置才生效"},
  {"scene": "看谁占了这个命令", "cmd": "/plugman lookup sit", "note": "排查命令冲突最直接"},
  {"scene": "看插件依赖关系", "cmd": "/plugman deps Essentials", "note": "决定卸载顺序，别把被依赖的卸了"},
  {"scene": "全部插件列表", "cmd": "/plugman list", "note": "带状态与版本"}
 ],
 "commands": [
  {"cmd": "plugman", "what": "插件热管理主指令", "syntax": "/plugman <list|info|load|unload|reload|enable|disable|check|deps|lookup|usage|dump|help>",
   "examples": ["/plugman list"], "notes": "别名 /pm"}
 ],
 "subcommands": [
  {"cmd": "/plugman list", "desc": "列出全部插件与启用状态", "example": "/plugman list"},
  {"cmd": "/plugman info <插件>", "desc": "查看插件版本、作者、依赖与命令", "example": "/plugman info Essentials"},
  {"cmd": "/plugman load <插件/jar>", "desc": "装载新插件（不重启）", "example": "/plugman load MyPlugin.jar"},
  {"cmd": "/plugman unload <插件>", "desc": "卸载插件并从内存移除", "example": "/plugman unload MyPlugin"},
  {"cmd": "/plugman reload <插件>", "desc": "重载插件（= unload + load）", "example": "/plugman reload Essentials"},
  {"cmd": "/plugman enable <插件>", "desc": "启用已加载但被禁用的插件", "example": "/plugman enable MyPlugin"},
  {"cmd": "/plugman disable <插件>", "desc": "禁用插件但保留在内存中", "example": "/plugman disable MyPlugin"},
  {"cmd": "/plugman check <插件>", "desc": "检查插件完整性与可安全重载性", "example": "/plugman check Essentials"},
  {"cmd": "/plugman deps <插件>", "desc": "查看依赖链（含反向依赖）", "example": "/plugman deps Essentials"},
  {"cmd": "/plugman lookup <命令>", "desc": "查询某个命令被哪个插件注册", "example": "/plugman lookup sit"},
  {"cmd": "/plugman usage <插件>", "desc": "查看插件注册的全部命令与用法", "example": "/plugman usage Essentials"},
  {"cmd": "/plugman dump", "desc": "导出插件环境诊断（反馈问题用）", "example": "/plugman dump"},
  {"cmd": "/plugman restart", "desc": "重启服务器（等价于安全重载全部）", "example": "/plugman restart"},
  {"cmd": "/plugman reloadconfig", "desc": "重载 PlugManX 自身配置", "example": "/plugman reloadconfig"}
 ],
 "caution": [
  "reload 一个插件不会重载它注册的任务与已打开的会话，很多插件「重载后行为怪」还是得重启。",
  "unload 被其他插件依赖的插件会连带把依赖方打挂，先 /plugman deps 看清方向。",
  "正在写入数据的插件（CoreProtect、经济类）别热重载，可能造成数据库句柄泄漏或事务中断。"
 ],
 "permissions": {
  "plugman.reload": "重载插件",
  "plugman.unload": "卸载插件",
  "plugman.load": "装载插件",
  "plugman.list": "查看插件列表与信息",
  "plugman.lookup": "查询命令归属"
 }
}
